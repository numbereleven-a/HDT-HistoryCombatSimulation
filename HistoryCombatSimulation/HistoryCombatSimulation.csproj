<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>HistoryCombatSimulation</AssemblyName>
    <RootNamespace>HistoryCombatSimulation</RootNamespace>
	<Version>1.4</Version>
	<InformationalVersion>1.4</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/_/HistoryCombatSimulation</PathMap>
    <HdtDir Condition="'$(HdtDir)' == ''">$(HDT_DIR)</HdtDir>
    <HdtExe Condition="'$(HdtExe)' == ''">$(HdtDir)\Hearthstone Deck Tracker\bin\x64\Release\HearthstoneDeckTracker.exe</HdtExe>
    <HearthDbPath Condition="'$(HearthDbPath)' == ''">$(HdtDir)\lib\HearthDb.dll</HearthDbPath>
    <HearthMirrorPath Condition="'$(HearthMirrorPath)' == ''">$(HdtDir)\lib\HearthMirror.dll</HearthMirrorPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="HearthstoneDeckTracker">
      <HintPath>$(HdtExe)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HearthDb">
      <HintPath>$(HearthDbPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HearthMirror">
      <HintPath>$(HearthMirrorPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckHdtDependencies" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(HdtExe)')" Text="HDT executable was not found. Set HDT_DIR/HdtDir or pass HdtExe explicitly." />
    <Error Condition="!Exists('$(HearthDbPath)')" Text="HearthDb.dll was not found. Set HDT_DIR/HdtDir or pass HearthDbPath explicitly." />
    <Error Condition="!Exists('$(HearthMirrorPath)')" Text="HearthMirror.dll was not found. Set HDT_DIR/HdtDir or pass HearthMirrorPath explicitly." />
  </Target>
</Project>
